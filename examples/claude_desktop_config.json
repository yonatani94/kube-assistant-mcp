// Example MCP client config for Claude Desktop.
// On macOS: ~/Library/Application Support/Claude/claude_desktop_config.json
// On Windows: %APPDATA%\Claude\claude_desktop_config.json
//
// Cursor uses the same shape under Settings -> MCP.
{
  "mcpServers": {
    "kube-assistant": {
      "command": "kube-assistant",
      "args": ["serve"],
      "env": {
        "KUBE_ASSISTANT_LLM_BACKEND": "ollama",
        "KUBE_ASSISTANT_LLM_MODEL": "llama3.1"
      }
    }
  }
}
